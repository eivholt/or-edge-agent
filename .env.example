# Text model used by the Pydantic AI agent.
LLM_BASE_URL=http://localhost:8081/v1
LLM_MODEL=mistralai/Ministral-3-3B-Instruct-2512-BF16
LLM_API_KEY=local-dev-key
LLM_MAX_CONTEXT=8192

# Local vision model used by inspect_scene. This endpoint must accept image_url content.
VLM_BASE_URL=http://localhost:8081/v1
VLM_MODEL=mistralai/Ministral-3-3B-Instruct-2512-BF16
VLM_API_KEY=local-dev-key
VLM_TIMEOUT_SECONDS=600
VLM_SEGMENT_RADIUS=64
VLM_SEGMENT_IMAGE_SIZE=224

# Backward-compatible fallback for LLM_API_KEY and VLM_API_KEY.
OPENAI_API_KEY=local-dev-key
EMR_BASE_URL=http://localhost:9000

# Azure OpenAI Responses API (for cloud vision tasks)
AZURE_VLM_ENDPOINT=https://<your-resource>.services.ai.azure.com/openai/v1/responses
AZURE_VLM_DEPLOYMENT=gpt-5.6-sol
AZURE_VLM_API_KEY=<your-api-key>